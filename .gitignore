# entorno y dependencias
.venv/
node_modules/

# secretos y datos del usuario
.env
danplay.db
danplay.db-wal
danplay.db-shm
# cualquier copia de la base: lleva las rutas y los titulos de TU musica
danplay.db.*
*.db.viejo*

# binario compilado del nucleo: pesa 40 MB y se genera con scripts/build.sh
desktop/src-tauri/binaries/

# artefactos de compilacion
target/
dist/
build/
__pycache__/
*.pyc
.pytest_cache/

# ffmpeg y fpcalc del instalador de Windows: se descargan al compilar
desktop/src-tauri/tools/*
!desktop/src-tauri/tools/LEEME.txt

# modo desarrollo con datos de prueba (scripts/dev.sh --prueba)
.dev/

# informes de pruebas y caches de herramientas
coverage/
htmlcov/
.coverage
.coverage.*
desktop/playwright-report/
desktop/test-results/
.ruff_cache/
.hypothesis/
*.egg-info/
