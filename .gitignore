# dependencias
node_modules/

# secretos y datos del usuario
.env
danplay.db
danplay.db-wal
danplay.db-shm
# cualquier copia de la base: lleva las rutas y los titulos de TU musica
danplay.db.*
*.db.viejo*

# el nucleo de un solo archivo de antes de la 1.30 (externalBin), si quedo
desktop/src-tauri/binaries/

# artefactos de compilacion
target/
dist/
dist-mobile/
build/

# lo que viaja con la app y se baja o se copia al compilar: ffmpeg, fpcalc,
# QuickJS y yt-dlp (scripts/tools-*.sh) y los datos con ONNX Runtime
# (scripts/data.sh); y el nucleo de Python empaquetado de hasta la 1.30, si
# quedo
desktop/src-tauri/tools/*
!desktop/src-tauri/tools/LEEME.txt
desktop/src-tauri/data/*
!desktop/src-tauri/data/LEEME.txt
desktop/src-tauri/core/

# modo desarrollo con datos de prueba (scripts/dev.sh --sandbox)
.dev/

# informes de pruebas y caches de herramientas
coverage/
desktop/playwright-report/
desktop/test-results/

# restos de Python de antes de la 1.40 (si quedaron en tu copia)
__pycache__/
*.pyc
