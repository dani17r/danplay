# ---- el indice (core/src/db.rs): ver danplay/library/db.py

class Row:
    def __getitem__(self, key: int | str | slice) -> Any: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[Any]: ...
    def keys(self) -> list[str]: ...

class Cursor:
    rowcount: int
    lastrowid: int | None
    arraysize: int
    description: tuple[tuple[str, None, None, None, None, None, None], ...] | None
    # como en typeshed para `sqlite3.Cursor`: lo que sale es una `Row`
    def fetchone(self) -> Any: ...
    def fetchall(self) -> list[Any]: ...
    def fetchmany(self, size: int | None = None) -> list[Any]: ...
    def close(self) -> None: ...
    def __iter__(self) -> Iterator[Any]: ...
    def __next__(self) -> Any: ...

class Connection:
    in_transaction: bool
    total_changes: int
    def execute(
        self, sql: str, parameters: Sequence[Any] | Mapping[str, Any] | None = None
    ) -> Cursor: ...
    def executemany(
        self, sql: str, seq_of_parameters: Iterable[Sequence[Any] | Mapping[str, Any]]
    ) -> Cursor: ...
    def executescript(self, sql_script: str) -> Cursor: ...
    def commit(self) -> None: ...
    def rollback(self) -> None: ...
    def close(self) -> None: ...
    def __enter__(self) -> Connection: ...
    def __exit__(
        self, exc_type: object, exc: object = None, tb: object = None
    ) -> Literal[False]: ...

def db_open(path: _Path) -> Connection: ...

