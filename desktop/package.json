{
  "name": "danplay-app",
  "private": true,
  "version": "1.40.0",
  "author": "Daniel Rangel (https://t.me/Dani17r)",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "dev:mobile": "vp dev --port 5274 --strictPort",
    "build:mobile": "vp build --mode mobile",
    "preview": "vp preview",
    "tauri": "tauri",
    "app": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "mobile": "bun run --cwd ../mobile tauri",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:coverage": "vp test run --coverage",
    "e2e": "playwright test",
    "perf": "vp build && playwright test -c e2e/perf/playwright.config.js",
    "lint": "eslint --concurrency auto --cache --cache-location node_modules/.cache/eslint/ src tests e2e scripts \"*.config.js\"",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "vp fmt --threads 4",
    "format:check": "vp fmt --check --threads 4",
    "typecheck": "vue-tsc --noEmit -p jsconfig.json",
    "icons": "node scripts/icons.mjs",
    "check": "vp run lint && vp run lint:css && vp run format:check && vp test run"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "driver.js": "1.10.2",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "5.0.3",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.2",
    "globals": "^17.13.0",
    "heroicons": "^2.2.0",
    "jsdom": "^30.1.3",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-plus": "1.1.0",
    "vitest": "5.0.3",
    "vue-tsc": "^3.3.13"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vitest": "5.0.3"
  }
}
