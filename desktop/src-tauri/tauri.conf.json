{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DanPlay",
  "version": "1.4.0",
  "identifier": "local.danplay.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5273",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DanPlay",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "theme": "Dark",
        "label": "main"
      },
      {
        "label": "mini",
        "url": "index.html?mini=1",
        "title": "DanPlay",
        "width": 340,
        "height": 196,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; media-src 'self' danplay: http://danplay.localhost; img-src 'self' danplay: http://danplay.localhost; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/danplay-core"
    ],
    "linux": {
      "deb": {
        "depends": [
          "ffmpeg",
          "libchromaprint-tools"
        ],
        "section": "sound",
        "priority": "optional",
        "desktopTemplate": "../../packaging/danplay.desktop",
        "postInstallScript": "../../packaging/deb/postinst",
        "postRemoveScript": "../../packaging/deb/postrm"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish",
          "English"
        ]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "shortDescription": "Gestor de biblioteca musical",
    "longDescription": "Identifica, renombra y organiza tu musica; reproduce, busca letra y acordes, y transpone tonos.",
    "resources": [
      "tools/*"
    ],
    "fileAssociations": [
      {
        "ext": [
          "mp3"
        ],
        "name": "DanPlay.mp3",
        "description": "Canción MP3",
        "mimeType": "audio/mpeg",
        "role": "Viewer"
      },
      {
        "ext": [
          "flac"
        ],
        "name": "DanPlay.flac",
        "description": "Canción FLAC",
        "mimeType": "audio/flac",
        "role": "Viewer"
      },
      {
        "ext": [
          "wav"
        ],
        "name": "DanPlay.wav",
        "description": "Sonido WAV",
        "mimeType": "audio/wav",
        "role": "Viewer"
      },
      {
        "ext": [
          "m4a"
        ],
        "name": "DanPlay.m4a",
        "description": "Canción M4A",
        "mimeType": "audio/mp4",
        "role": "Viewer"
      },
      {
        "ext": [
          "ogg"
        ],
        "name": "DanPlay.ogg",
        "description": "Canción OGG",
        "mimeType": "audio/ogg",
        "role": "Viewer"
      },
      {
        "ext": [
          "opus"
        ],
        "name": "DanPlay.opus",
        "description": "Canción Opus",
        "mimeType": "audio/opus",
        "role": "Viewer"
      },
      {
        "ext": [
          "aac"
        ],
        "name": "DanPlay.aac",
        "description": "Canción AAC",
        "mimeType": "audio/aac",
        "role": "Viewer"
      },
      {
        "ext": [
          "wma"
        ],
        "name": "DanPlay.wma",
        "description": "Canción WMA",
        "mimeType": "audio/x-ms-wma",
        "role": "Viewer"
      }
    ],
    "category": "Music"
  }
}
