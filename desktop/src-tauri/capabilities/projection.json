{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "projection",
  "description": "Permisos de la ventana de proyeccion: la letra en grande para el proyector. Necesita los eventos (sigue lo que suena) y poner y quitar la pantalla completa.",
  "windows": [
    "projection"
  ],
  "permissions": [
    "core:app:default",
    "core:event:default",
    "core:path:default",
    "core:webview:default",
    "core:window:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-title"
  ]
}
