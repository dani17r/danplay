# Copia este archivo a .env y rellena tus claves.
#
# La IA se configura desde la app (Ajustes → Inteligencia artificial): ahi
# eliges el proveedor —OpenAI, Anthropic, Google Gemini, DeepInfra,
# OpenRouter, Ollama en tu equipo…— y se guarda en ~/.config/danplay/ai.json.
# Estas variables solo hacen falta para la linea de ordenes o las pruebas, y
# mandan sobre lo guardado:
# DANPLAY_AI_PROVIDER=openrouter      # id del catalogo (library/src/ai/providers.rs)
# DANPLAY_AI_KEY=
# DANPLAY_AI_MODEL=                   # el rapido (identificar, fichas)
# DANPLAY_AI_CHAT_MODEL=              # el del asistente (con herramientas)
# DANPLAY_AI_BASE_URL=                # solo para «otro» o para cambiar la URL
#
# Si tenias DEEPINFRA_API_KEY de antes, sigue valiendo: se migra sola al
# perfil de DeepInfra la primera vez.
ACOUSTID_API_KEY=
# Donde esta tu musica. Si lo dejas vacio, se usa ~/Musica
# DANPLAY_LIBRARY=/ruta/a/tu/musica
# Lo que mueves o borras por fuera de la app (el gestor de archivos, un disco
# que se desmonta) se ve solo: DanPlay vigila las carpetas. DANPLAY_WATCH=0 lo
# apaga; el repaso completo de seguridad es cada DANPLAY_RESCAN_MINUTES (0 = nunca).
# DANPLAY_WATCH=1
# DANPLAY_RESCAN_MINUTES=10
# Otras carpetas para los datos (base, indice, caches) y los ajustes: un
# DanPlay portatil, o un entorno aislado. Por defecto, las del sistema.
# DANPLAY_DATA_DIR=
# DANPLAY_CONFIG_DIR=
# 0 = no leer este .env ni la base del proyecto (los entornos de prueba)
# DANPLAY_PROJECT_ENV=1
# De donde se bajan las versiones de yt-dlp («Actualizar yt-dlp», y la
# primera descarga si aun no hay ninguno): la API de versiones de GitHub, u
# otra que conteste igual si a GitHub no se puede salir
# DANPLAY_YTDLP_RELEASES=https://api.github.com/repos/yt-dlp/yt-dlp/releases
# Una carpeta con ffmpeg, fpcalc, qjs o yt-dlp, que se miran antes que los del
# sistema (la app ya le da la suya: tools/ del paquete)
# DANPLAY_TOOLS_DIR=
# 0 = sin inteligencia artificial (ni asistente, ni fichas, ni identificar con IA)
# DANPLAY_AI=1
# Lo que bajas o importas: la carpeta de entrada (dentro de la biblioteca),
# pasarlo a mp3 (1) y con que calidad (high, medium o variable), si se guarda
# el original al convertir, y las carpetas que nunca se convierten
# DANPLAY_INBOX=Entrada
# DANPLAY_CONVERT=0
# DANPLAY_QUALITY=high
# DANPLAY_KEEP_ORIGINAL=0
# DANPLAY_NEVER_CONVERT=Secuencias,Pistas,Multitracks,Stems
# 0 = no escribir etiquetas en los archivos (solo en el indice)
# DANPLAY_TAGS=1
# El formato de las pistas al separar (flac, ogg u opus)
# DANPLAY_STEMS_FORMAT=flac
# Lo parecidas que tienen que ser dos canciones para salir en Duplicados (0 a 1)
# DANPLAY_DUP_THRESHOLD=0.88
