# Copia este archivo a .env y rellena tus claves.
#
# La IA se configura desde la app (Ajustes → Inteligencia artificial): ahi
# eliges el proveedor —OpenAI, Anthropic, Google Gemini, DeepInfra,
# OpenRouter, Ollama en tu equipo…— y se guarda en ~/.config/danplay/ai.json.
# Estas variables solo hacen falta para la linea de ordenes o las pruebas, y
# mandan sobre lo guardado:
# DANPLAY_AI_PROVIDER=openrouter      # id del catalogo (danplay/providers.py)
# DANPLAY_AI_KEY=
# DANPLAY_AI_MODEL=                   # el rapido (identificar, fichas)
# DANPLAY_AI_CHAT_MODEL=              # el del asistente (con herramientas)
# DANPLAY_AI_BASE_URL=                # solo para «otro» o para cambiar la URL
#
# Si tenias DEEPINFRA_API_KEY de antes, sigue valiendo: se migra sola al
# perfil de DeepInfra la primera vez.
ACOUSTID_API_KEY=
# Donde esta tu musica. Si lo dejas vacio, se usa ~/Musica
# DANPLAY_LIBRARY=/ruta/a/tu/musica
# Lo que mueves o borras por fuera de la app (el gestor de archivos, un disco
# que se desmonta) se ve solo: DanPlay vigila las carpetas. DANPLAY_WATCH=0 lo
# apaga; el repaso completo de seguridad es cada DANPLAY_RESCAN_MINUTES (0 = nunca).
# DANPLAY_WATCH=1
# DANPLAY_RESCAN_MINUTES=10
